{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "synapsebot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  // Static page from public/; only /api/* reaches the Worker.
  "assets": {
    "directory": "./public/",
    "run_worker_first": ["/api/*"]
  },
  // Per-visitor cap on questions, counted per Cloudflare location.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
  // Secrets (set with `wrangler secret put`, never here): ANTHROPIC_API_KEY, ACCESS_CODE.
}
